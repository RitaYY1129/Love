NODE_ENV=development
PORT=3001
JWT_SECRET=replace-with-a-long-random-secret
JWT_EXPIRES_IN=30d

# ===== 实时通话信令所需的 Supabase 配置 =====
# 视频/语音通话信令服务通过 Supabase 读取情侣关系、写入 call_records
# 请在 Supabase 控制台 -> Project Settings -> API 获取
SUPABASE_URL=https://your-project.supabase.co
# 注意：必须是 service_role key（服务端密钥，切勿暴露到前端）
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key

DB_HOST=127.0.0.1
DB_PORT=3306
DB_USER=root
DB_PASSWORD=
DB_NAME=love_diary

# 允许的前端来源（部署后把 GitHub Pages 域名加进来，逗号分隔；留空则允许所有）
CORS_ORIGINS=

# WeChat Open Platform mobile application credentials.
WECHAT_APP_ID=
WECHAT_APP_SECRET=

# console is allowed only outside production. Use tencent in production.
SMS_PROVIDER=console
SMS_CODE_SECRET=replace-with-another-long-random-secret
SMS_CODE_TTL_SECONDS=300
TENCENT_SMS_SECRET_ID=
TENCENT_SMS_SECRET_KEY=
TENCENT_SMS_REGION=ap-guangzhou
TENCENT_SMS_SDK_APP_ID=
TENCENT_SMS_SIGN_NAME=
TENCENT_SMS_TEMPLATE_ID=

