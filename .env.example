# Supabase 云后端（账号/数据）
VITE_SUPABASE_URL=https://your-project.supabase.co
VITE_SUPABASE_ANON_KEY=your-anon-key

# 本地调试用，线上不依赖
VITE_API_BASE=/api

# ===== 实时音视频通话信令地址（关键）=====
# 必须指向一个公网部署的 love-diary-backend 地址（含 / 结尾或不含均可）
# 例如部署在 Render 后： https://love-diary-backend.onrender.com
# 不配置时前端会连当前页面域名，那是没有 Socket.IO 的 GitHub Pages，视频将无法接通
VITE_SOCKET_URL=

# ===== WebRTC TURN 中继（手机 4G/5G 打通必需）=====
# 大多数家用/手机网络只靠 STUN 连不通，需要一个 TURN 服务器做中继
# 免费方案：https://www.metered.ca/tools/openrelay 申请，或用 coturn 自建
# 格式： turn:turn.example.com:3478
VITE_TURN_URL=
VITE_TURN_USERNAME=
VITE_TURN_CREDENTIAL=
